#!/bin/sh

set -e
unset PARINIT

PARTESTRETURN=0
if [ "$1" != "" ] ; then
	PAR="$1"
else
	PAR="par"
fi

if test "fe312d7f217516ea69f7b40eb5cfb3ce  -" != \
	"$(${PAR} 72 < tests/data/cicero_de_officiis.ascii \
	| md5sum)" ; then
	echo Cicero par 72 FAIL
	echo ----
	${PAR} 72 < tests/data/cicero_de_officiis.ascii
	echo ----
	PARTESTRETURN=1
else
	echo Cicero par 72 SUCCESS
fi

if test "7c8aceaf81ba7d84a899da0126b7e3b3  -" != \
	"$(${PAR} 45 < tests/data/cicero_de_officiis.ascii \
	| md5sum)" ; then
	echo Cicero par 45 FAIL
	echo ----
	${PAR} 45 < tests/data/cicero_de_officiis.ascii
	echo ----
	PARTESTRETURN=1
else
	echo Cicero par 45 SUCCESS
fi

