	| md5sum)" ; then
	echo Kivi UTF-8 72 FAIL
	echo ----
	${PAR} 72 < tests/data/seitsemaen_veljestae.utf8
	echo ----
	PARTESTRETURN=1
else
	echo Kivi UTF-8 72 SUCCESS
fi

if test "1c83a8fdce6fe012ce0d3d54cfc4acf3  -" != \
	"$(${PAR} 45 < tests/data/seitsemaen_veljestae.utf8 \
	| md5sum)" ; then
	echo Kivi UTF-8 45 FAIL
	echo ----
	${PAR} 45 < tests/data/seitsemaen_veljestae.utf8
	echo ----
	PARTESTRETURN=1
else
	echo Kivi UTF-8 45 SUCCESS
fi

if test "2356e309ef6b6d98137b7f83e3e7b7eb  -" != \
	"$(${PAR} 72 < tests/data/macha.cikani.utf8 \
	| md5sum)" ; then
	echo Cikani UTF-8 72 FAIL
	echo ----
	${PAR} 72 < tests/data/macha.cikani.utf8
	echo ----
	PARTESTRETURN=1
else
	echo Cikani UTF-8 72 SUCCESS
